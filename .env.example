DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

POSTGRES_DB=cadence
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
DATABASE_URL=postgres://cadence:cadence@postgres:5432/cadence

RABBITMQ_DEFAULT_USER=cadence
RABBITMQ_DEFAULT_PASS=cadence
CELERY_BROKER_URL=amqp://cadence:cadence@rabbitmq:5672//

TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false

CADENCE_TIME_ZONE=Europe/Moscow
LOG_LEVEL=INFO
# CADENCE_LOG_DIR=/workspace/logs
# CADENCE_SERVICE_NAME=api
CSRF_TRUSTED_ORIGINS=http://localhost:8080

NGINX_HTTP_PORT=8080
